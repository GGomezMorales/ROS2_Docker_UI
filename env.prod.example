# =============================================================================
# .env.prod.example — copy to .env.prod and edit before deploying
# -----------------------------------------------------------------------------
# Used with: docker compose --env-file .env.prod -f compose.prod.yml ...
#
# Do NOT commit the real .env.prod to source control.
# =============================================================================

# Public domain Caddy will serve. DNS A record must point to this VPS first,
# otherwise Caddy's automatic Let's Encrypt cert issuance will fail.
APP_DOMAIN=your-domain.example

# Browser-side rosbridge URL. Must be wss:// (TLS) for a public deployment,
# and must match the /rosbridge path that Caddy reverse-proxies.
# Vite inlines this value into the static bundle at BUILD time, so changes
# require `docker compose --env-file .env.prod -f compose.prod.yml build`.
VITE_ROSBRIDGE_URL=wss://your-domain.example/rosbridge

# Which Transport implementation the React shell builds. For a public demo
# you almost always want `rosbridge`. Allowed: none | mock | memory | rosbridge.
VITE_TRANSPORT_KIND=rosbridge
